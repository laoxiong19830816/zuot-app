# ========== 服务基础 ==========
PORT=8080
NODE_ENV=production

# PostgreSQL 连接串（Docker Compose 内用服务名 db；本地调试用 localhost）
DATABASE_URL=postgresql://zuot:zuot_pwd@db:5432/zuot?schema=public

# JWT 密钥：务必改成随机长字符串（可用 openssl rand -hex 32 生成）
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_EXPIRES_IN=30d

# ========== 火山引擎方舟 · 豆包 ==========
ARK_API_KEY=你的方舟APIKey
# 方舟 OpenAI 兼容地址（华北2北京）；如使用推理接入点，把 ARK_MODEL 换成 ep-xxxx 即可
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=Doubao-Seed-2.1-pro
ARK_TIMEOUT_MS=120000

# ========== 自建行情服务（Python + AkShare）==========
QUOTE_SERVICE_URL=http://quote:8620

# ========== 调度开关 ==========
# 没有常驻服务器时必须设 false，改用 App 内「立即刷新」手动触发。
# ⚠️ 设 true 但进程不是 7×24 常驻，定时任务会静默不执行，还会白白消耗 AI 额度。
SCHEDULER_ENABLED=false
# 时区（必须是 Asia/Shanghai，否则定时任务时间会错）
TZ=Asia/Shanghai

# ========== 注册与权限 ==========
# open=开放注册 / invite=需邀请码（推荐） / closed=关闭注册
REGISTER_MODE=invite
# 首个注册的用户自动成为管理员（用于初始化）；上线稳定后建议设 false
BOOTSTRAP_FIRST_USER_AS_ADMIN=true
# 超级管理员初始账号（首次启动时自动创建）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_pwd

# ========== AI 额度（防超支）==========
AI_DAILY_LIMIT=20
AI_MONTHLY_LIMIT=400
